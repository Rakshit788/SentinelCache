{
  "uid": "sentinelcache",
  "title": "SentinelCache",
  "tags": ["sentinelcache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 0.5 },
        { "color": "green", "value": 0.8 }
      ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(cache_hits_total[1m])) / (sum(rate(cache_hits_total[1m])) + sum(rate(cache_misses_total[1m])))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy Nodes",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 1 },
        { "color": "green", "value": 2 }
      ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "healthy_nodes", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ring Nodes",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "ring_nodes", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Read Repairs (total)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "read_repairs_total", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache Hits vs Misses (rate, per node)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}} hits", "expr": "sum by (instance) (rate(cache_hits_total[1m]))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "B", "legendFormat": "{{instance}} misses", "expr": "sum by (instance) (rate(cache_misses_total[1m]))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evictions & Expirations (rate, per node)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}} evictions", "expr": "sum by (instance) (rate(cache_evictions_total[1m]))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "B", "legendFormat": "{{instance}} expirations", "expr": "sum by (instance) (rate(cache_expirations_total[1m]))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Proxy Request Rate by Method",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}}", "expr": "sum by (method) (rate(request_count{job=\"sentinelcache-proxy\"}[1m]))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Proxy Request Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum(rate(request_latency_seconds_bucket{job=\"sentinelcache-proxy\"}[1m])) by (le))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket{job=\"sentinelcache-proxy\"}[1m])) by (le))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum(rate(request_latency_seconds_bucket{job=\"sentinelcache-proxy\"}[1m])) by (le))", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Quorum Success vs Failure (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "success", "expr": "rate(quorum_success_total[1m])", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "B", "legendFormat": "failure", "expr": "rate(quorum_failure_total[1m])", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replica Read/Write Failures (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "read failures", "expr": "rate(replica_read_failures_total[1m])", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } },
        { "refId": "B", "legendFormat": "write failures", "expr": "rate(replica_write_failures_total[1m])", "datasource": { "type": "prometheus", "uid": "sentinelcache-prometheus" } }
      ]
    }
  ]
}
